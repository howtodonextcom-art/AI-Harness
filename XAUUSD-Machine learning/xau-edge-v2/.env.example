# Copy to .env (git-ignored). Operational alerts only; never a signal, price or PnL.
# 1) Create a bot with @BotFather and paste its token. 2) Send the bot a message.
# 3) python scripts/telegram_find_chat.py prints the chat id. 4) python scripts/telegram_test.py
XAU_V2_TELEGRAM_BOT_TOKEN=
XAU_V2_TELEGRAM_CHAT_ID=

# A copy of every daily backup on ANOTHER DEVICE (external drive, NAS, or a cloud-synced folder
# that is signed in and syncing). Until set, /health says no off-device copy exists.
# XAU_V2_BACKUP_OFFDEVICE_DIR=E:/XAU-EDGE-V2-backups

# Extra copies on other partitions (a JSON list). Default: D:/XAU-EDGE-V2-backups when D: exists.
# XAU_V2_BACKUP_MIRRORS=["D:/XAU-EDGE-V2-backups"]
