# Copy to .env and fill in. NEVER commit .env.
# Live trading is not implemented and must stay false.
XAU_EDGE_ENABLE_LIVE_TRADING=false
XAU_EDGE_DATA_DIR=data
# Economic calendar CSV (first line '# coverage: <start>Z..<end>Z'); empty = news unknown, signals WAIT.
XAU_EDGE_NEWS_CALENDAR_PATH=
XAU_EDGE_LOG_LEVEL=INFO

# Demo execution planning flags. Disabled by default; dry-run remains true until an operator
# deliberately enables demo order submission after all safety gates are implemented and tested.
XAU_EDGE_ENABLE_DEMO_TRADING=false
XAU_EDGE_DEMO_DRY_RUN=true
# Pipeline smoke test: ONE minimum-lot demo order, labelled, closed at once. Off by default.
XAU_EDGE_DEMO_SMOKE=false
XAU_EDGE_DEMO_DEVIATION_POINTS=30
XAU_EDGE_DEMO_ALLOWED_ACCOUNTS=
XAU_EDGE_DEMO_ALLOWED_SYMBOLS=XAUUSD
XAU_EDGE_DEMO_MAGIC=
XAU_EDGE_DEMO_MAX_LOTS=1.0
XAU_EDGE_DEMO_MAX_ORDERS_PER_DAY=1
# Challenge size the loss limits are measured from; empty = the first balance the bot sees.
XAU_EDGE_DEMO_INITIAL_CAPITAL=
XAU_EDGE_DEMO_STATE_PATH=data/execution/state.sqlite
XAU_EDGE_DEMO_JOURNAL_PATH=data/execution/journal.jsonl

# MetaTrader 5 (read-only market data). Use a demo account.
MT5_LOGIN=
# Prefer the investor/read-only password for data-only scripts.
MT5_PASSWORD=
# Trade password is for future DEMO execution only; never use it for data-only scripts.
MT5_TRADE_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
# Broker server timezone (IANA name, e.g. Europe/Athens). Required for MT5 data:
# MT5 returns server wall-clock time labelled as UTC; it must be converted explicitly.
MT5_BROKER_TIMEZONE=
